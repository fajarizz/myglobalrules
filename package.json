{
  "name": "@local/myglobalrules",
  "version": "1.0.0",
  "private": false,
  "license": "MIT",
  "type": "module",
  "description": "Global hook injecting the user's AGENTS.md rules into every agent's system prompt.",
  "exports": {
    ".": "./index.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "AGENTS.md",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
